  "concept_id": "sound_three_elements",
  "hints": [
   "音調由振動的快慢決定，響度由振幅決定。",
   "弦拉得越緊，每秒振動的次數越多。",
   "振動越快 → 頻率越高 → 音調越高。"
  ],
  "options": {
   "A": "音調變高",
   "B": "音調變低",
   "C": "響度變小",
   "D": "音色改變但音調不變"
  },
  "answer": "A",
  "imageUrl": null,
  "gold": 16,
  "hp": 7,
  "atk": 3,
  "def": 2
 },
 {
  "chapter": "final-10",
