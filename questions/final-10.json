   "沒有空氣就沒有能被推動的粒子。"
  ],
  "options": {
   "A": "月球表面接近真空，缺少傳聲的介質",
   "B": "月球重力太小，聲音傳不動",
   "C": "鑼在低溫下不會振動",
   "D": "聲音被月塵完全吸收"
  },
  "answer": "A",
  "imageUrl": null,
  "gold": 16,
  "hp": 7,
  "atk": 3,
  "def": 2
 },
 {
